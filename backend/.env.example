# ==========================================
# Configuración del Servidor y Red Interna
# ==========================================
PORT=3000
# 0.0.0.0 permite recibir conexiones dentro de contenedores Docker y redes locales
HOST=0.0.0.0
NODE_ENV=development

# ==========================================
# Base de Datos PostgreSQL
# ==========================================
# En la nube (Neon DB):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"
# En Docker Compose (host interno del servicio de base de datos):
# DATABASE_URL="postgresql://postgres:postgres@db:5432/leccostore?schema=public"
# En local fuera de Docker:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# ==========================================
# Seguridad y Autenticación JWT
# ==========================================
# Generar clave con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GENERA_UNO_CON: node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""

# ==========================================
# CORS / Orígenes de Frontend Permitidos
# ==========================================
# Acepta un único origen o múltiples separados por comas
# Ejemplo Docker/Local: http://localhost:5173,http://localhost:80,http://frontend:5173
FRONTEND_URL="http://localhost:5173"

# ==========================================
# Cloudinary (Almacenamiento Multimedia)
# ==========================================
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# ==========================================
# Resend (Correos Transaccionales)
# ==========================================
RESEND_API_KEY="tu_resend_api_key"
RESEND_FROM_EMAIL="Lecco Store <noreply@tudominio.com>"
ADMIN_EMAIL="admin@tudominio.com"



# ==========================================
# Brevo (Marketing: contactos, newsletter, campañas)
# ==========================================
# API key (empieza por "xkeysib-"). No uses la clave MCP (base64) ni la SMTP.
BREVO_API_KEY="xkeysib-..."
# IDs de las listas: ejecuta `pnpm brevo:setup` y copia lo que imprime
BREVO_LISTA_CLIENTES_ID=
BREVO_LISTA_NEWSLETTER_ID=
# Plantilla de doble opt-in creada en Brevo (debe incluir {{ params.DOIurl }})
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL="http://localhost:5173/?suscripcion=confirmada"
# Token secreto del webhook de bajas: genera uno con
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BREVO_WEBHOOK_TOKEN= 
