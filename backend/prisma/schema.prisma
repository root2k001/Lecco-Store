generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int                @id @default(autoincrement())
  nombre        String
  email         String             @unique
  password      String    
  rol           String             @default("cliente")
  creadoEn      DateTime           @default(now())
  // Consentimiento expreso para recibir marketing (Ley 29733). Se sincroniza con Brevo.
  aceptaMarketing  Boolean   @default(false)
  consentimientoEn DateTime?
  pedidos       Pedido[]
  historial     HistorialCambios[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  creadoEn  DateTime @default(now())

  @@index([usuarioId])
}

model Producto {
  id                  Int          @id @default(autoincrement())
  nombre              String
  precio              Decimal      @db.Decimal(10, 2)
  imagen              String?
  genero              String       
  color               String?
  stock               Int          @default(0)
  descripcion         String?
  colores             String[]     @default([])
  imagenesAdicionales String[]     @default([])
  videos              String[]     @default([])
  coleccion           Boolean      @default(false)
  sale                Boolean      @default(false)
  nuevosingresos      Boolean  @default(false)
  creadoEn            DateTime     @default(now())
  items               ItemPedido[]
  campanas            Campana[]

  // Filtros del catálogo (/Sale, /Coleccion, nuevos ingresos) ordenados por fecha
  @@index([sale, creadoEn])
  @@index([coleccion, creadoEn])
  @@index([nuevosingresos, creadoEn])
  @@index([creadoEn])
}

model Pedido {
  id           Int          @id @default(autoincrement())
  usuarioId    Int?         // null = pedido de invitado (Opción A: Guest Checkout)
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id])
  total        Decimal      @db.Decimal(10, 2)
  estado       String       @default("pendiente")
  direccion    String?
  ciudad       String?
  codigoPostal String?
  telefono     String?
  creadoEn     DateTime     @default(now())
  items        ItemPedido[]
  origenCampana String? // slug de la campaña (UTM) que originó la venta

  @@index([usuarioId, creadoEn]) // /mis-pedidos
  @@index([creadoEn])            // listado admin y pedidos de hoy
}

model ItemPedido {
  id         Int      @id @default(autoincrement())
  pedidoId   Int
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
  precioUnit Decimal  @db.Decimal(10, 2)
  color      String?

  @@index([pedidoId])
  @@index([productoId])
}

model HistorialCambios {
  id       Int      @id @default(autoincrement())
  adminId  Int
  admin    Usuario  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  accion   String
  detalle  String
  creadoEn DateTime @default(now())

  @@index([creadoEn])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  creadoEn  DateTime @default(now())
}

model MensajeContacto {
  id       Int      @id @default(autoincrement())
  nombre   String
  email    String
  telefono String?
  mensaje  String
  creadoEn DateTime @default(now())
}

// Campañas temporales de la tienda (ej. "Colección de Verano"): agrupan productos,
// tienen fechas de vigencia y su propia página /campanas/:slug.
model Campana {
  id          Int        @id @default(autoincrement())
  slug        String     @unique // "verano-2027": URL y utm_campaign de Brevo
  titulo      String
  descripcion String?
  banner      String?
  inicio      DateTime
  fin         DateTime
  activa      Boolean    @default(true)
  creadoEn    DateTime   @default(now())
  productos   Producto[]

  @@index([activa, inicio, fin])
}
