{
  "name": "lecco-backend",
  "version": "1.0.0",
  "description": "Backend API para Lecco Store",
  "main": "server.js",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "start": "node server.js",
    "dev": "prisma generate && node --watch server.js",
    "build": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node seedAdmin.js",
    "test": "node --test --test-concurrency=1 test/flujo-negocio.test.js test/brevo.test.js test/campanas.test.js",
    "brevo:setup": "node scripts/brevo-setup.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "resend": "^6.14.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ]
  }
}