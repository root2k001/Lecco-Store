# ==========================================
# Variables de Entorno del Frontend (Vite)
# ==========================================

# Puerto donde corre el frontend de Vite
VITE_PORT=5173

# Host de red para exponer Vite (true = 0.0.0.0 para Docker)
VITE_HOST=true

# Destino del proxy para peticiones /api
# - Desarrollo local en máquina anfitriona: http://localhost:3000
# - En red interna de Docker Compose: http://backend:3000
BACKEND_URL=http://localhost:3000

# WhatsApp para atención de pedidos
VITE_WHATSAPP_NUMERO=51966894989

