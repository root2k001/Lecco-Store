# ==========================================
# Variables de Entorno del Frontend (Next.js)
# ==========================================
# En Vercel: Project Settings → Environment Variables

# Backend Express (proxy /api y precarga de datos en el servidor)
# - Local: http://localhost:3000  · Docker Compose: http://backend:3000
# - Producción: si no se define, se usa https://lecco-store-1.onrender.com
BACKEND_URL=http://localhost:3000

# URL pública del sitio: canónicas, Open Graph, sitemap.xml y robots.txt
# Producción: tu dominio (p. ej. https://lecco.pe)
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# WhatsApp para atención de pedidos
NEXT_PUBLIC_WHATSAPP_NUMERO=51966894989
